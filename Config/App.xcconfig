// Shared build settings. Personal values (API key, signing team) go in Secrets.xcconfig,
// which git ignores. Copy Secrets.example.xcconfig to get started.

PRODUCT_BUNDLE_IDENTIFIER = com.vedanta.accessnav
DEVELOPMENT_TEAM =

// Which model spots elevators, ramps and stairs while scanning: openai or gemini.
VISION_PROVIDER = openai

OPENAI_API_KEY =
OPENAI_MODEL = gpt-6.1-sol
OPENAI_REASONING_EFFORT = low

GEMINI_API_KEY =
GEMINI_MODEL = gemini-3.8-flash

// Spoken navigation prompts and Ask InView answers: ElevenLabs when a key is set, the system voice otherwise.
ELEVENLABS_API_KEY =
ELEVENLABS_VOICE_ID = 21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL = eleven_turbo_v2_5

// Community account, submission and published-map service; blank keeps browsing local.
// Write URLs as http:/$()/host:3000 so xcconfig does not treat // as a comment.
INVIEW_BACKEND_URL =
// Its bearer token (the TF_VAR_api_token used to deploy it). Built into the app, so nobody types it on the phone.
INVIEW_BACKEND_TOKEN =
// A backend running on your own Mac (backend/run-local.sh prints the address). Same token as above.
INVIEW_LOCAL_BACKEND_URL =
// YES makes new installs use the Mac server by default; the Scanning settings screen can switch either way.
INVIEW_USE_LOCAL_BACKEND = NO

// Sign in with Apple or email through Auth0 (passwordless Universal Login). These are public
// identifiers, not secrets: the native app uses PKCE and has no client secret. Clear
// INVIEW_AUTH0_DOMAIN to fall back to email and password. Write // as :/$()/ in xcconfig.
INVIEW_AUTH0_DOMAIN = inview.us.auth0.com
INVIEW_AUTH0_CLIENT_ID = fzUUl4rl0YTRzUGLhdGe6uMp4Ue55Nfx
// Must match Allowed Callback URLs in the Auth0 application.
INVIEW_AUTH0_CALLBACK_URL = inview:/$()/inview.us.auth0.com/ios/com.inview.InView/callback

// Public token for surrounding maps and placement. Override in Secrets.xcconfig.
MAPBOX_ACCESS_TOKEN =

#include? "Secrets.xcconfig"
