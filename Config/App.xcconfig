// Shared build settings. Personal values (API key, signing team) go in Secrets.xcconfig,
// which git ignores. Copy Secrets.example.xcconfig to get started.

PRODUCT_BUNDLE_IDENTIFIER = com.vedanta.accessnav
DEVELOPMENT_TEAM =

OPENAI_API_KEY =
OPENAI_MODEL = gpt-6.1-sol
OPENAI_REASONING_EFFORT = low

// Optional room processing server. The app also lets you set this address in Settings.
// In xcconfig URLs, write http:/$()/host:3000 to avoid // being parsed as a comment.
INVIEW_BACKEND_URL =

#include? "Secrets.xcconfig"
