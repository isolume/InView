// Copy to Config/Secrets.xcconfig (git-ignored) and fill in.

// Elevator, ramp and stairs detection while scanning. Without a key, pin points by hand.
// VISION_PROVIDER picks which key is used: openai (default) or gemini.
// GEMINI_API_KEY also answers spoken questions like "where is room 204?" from the search bar.
OPENAI_API_KEY =
GEMINI_API_KEY =
// VISION_PROVIDER = gemini

// Your Apple developer team ID (Xcode > Settings > Accounts), needed to run on a device.
DEVELOPMENT_TEAM =

// Public Mapbox token for surrounding maps and placement.
MAPBOX_ACCESS_TOKEN =

// Community account, submission and published-map service. Leave blank for local browsing.
// Write URLs as http:/$()/host:3000.
INVIEW_BACKEND_URL =
// Its bearer token, the same value as TF_VAR_api_token when the server was deployed.
INVIEW_BACKEND_TOKEN =
// Optional: the backend on your own Mac, e.g. http:/$()/192.168.1.23:3000 (backend/run-local.sh prints it).
INVIEW_LOCAL_BACKEND_URL =
// INVIEW_USE_LOCAL_BACKEND = YES

// Auth0 sign-in defaults are in App.xcconfig; override them here to use your own tenant.
// INVIEW_AUTH0_DOMAIN =
// INVIEW_AUTH0_CLIENT_ID =
// INVIEW_AUTH0_CALLBACK_URL = myscheme:/$()/your-tenant.us.auth0.com/ios/your.bundle.id/callback

// Spoken navigation prompts and Ask InView answers. Without a key, the system voice is used.
ELEVENLABS_API_KEY =
// ELEVENLABS_VOICE_ID = 21m00Tcm4TlvDq8ikWAM
// ELEVENLABS_MODEL = eleven_turbo_v2_5

// Optional overrides.
// PRODUCT_BUNDLE_IDENTIFIER = com.yourname.accessnav
// OPENAI_MODEL = gpt-6-luna
// OPENAI_REASONING_EFFORT = none
// GEMINI_MODEL = gemini-3.1-pro-preview
