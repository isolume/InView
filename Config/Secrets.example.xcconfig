// Copy to Config/Secrets.xcconfig (git-ignored) and fill in.

// Elevator and ramp detection while scanning. Without it, pin points by hand.
GEMINI_API_KEY =

// Spoken directions. Without a key the app falls back to the system voice.
ELEVENLABS_API_KEY =

// Live outage server (see server/README.md). Host only, no scheme.
SERVER_HOST =
// SERVER_SCHEME = http

// Your Apple developer team ID (Xcode > Settings > Accounts), needed to run on a device.
DEVELOPMENT_TEAM =

// Optional overrides.
// PRODUCT_BUNDLE_IDENTIFIER = com.yourname.accessnav
// GEMINI_MODEL = gemini-3.1-pro-preview
// ELEVENLABS_VOICE_ID = any voice ID from your ElevenLabs voice library
